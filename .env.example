# ---- MongoDB Atlas ----
# Atlas UI -> Connect -> Drivers -> copy the SRV string (replace <password>)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=teambrain

# ---- Embeddings (Voyage AI) ----
# Key from https://dash.voyageai.com  (or an Atlas "Model API key" + VOYAGE_BASE_URL=https://ai.mongodb.com/v1)
VOYAGE_API_KEY=pa-xxxxxxxxxxxxx
VOYAGE_MODEL=voyage-3.5
VOYAGE_BASE_URL=https://api.voyageai.com/v1
# Must match numDimensions of the vector index (setup_db.py creates it with this value)
EMBED_DIM=1024
# voyage | fake   (fake = offline hashing embeddings, only for testing without a key)
EMBED_PROVIDER=

# ---- LLM (Anthropic Claude) ----
ANTHROPIC_API_KEY=
# anthropic | mock   (mock = offline heuristic, only for testing without a key)
LLM_PROVIDER=groq
LLM_API_KEY=gsk_xxxxxxxxxxxxx
# Optional overrides (needed for openrouter/openai, or if a default model id was retired)
LLM_CHAT_MODEL=
LLM_MEMORY_MODEL=
LLM_BASE_URL=
# Optional backup provider, used automatically when the primary fails or stays rate limited
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
CHAT_MODEL=claude-opus-5-5
MEMORY_MODEL=claude-haiku-5-5
CHAT_EFFORT=low
